                  "pm.collectionVariables.set(\"member_email\", `member+${runId}@example.com`);",
                  "",
                  "pm.collectionVariables.set(\"club_name\", `Clube Leituras Noturnas ${runId}`);",
                  "pm.collectionVariables.set(\"club_description\", \"Clube para leitura mensal de ficção, suspense e clássicos.\");",
